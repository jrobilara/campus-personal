---
// Portada provisoria del hito 0: lista las áreas de areas.yaml. La portada real llega en el hito 1.
import Base from '../layouts/Base.astro';
import { cargarCampus } from '../contenido/campus';
import { url } from '../lib/url';

const campus = await cargarCampus();
---
<Base titulo="Campus personal">
  <main>
    <h1>Campus personal</h1>
    <ul>
      {campus.areas.map((a) => (
        <li>
          <strong>{a.nombre}</strong> — {a.descripcion}
          <span class="meta"> ({campus.temas.filter((t) => t.area === a.id).length} temas)</span>
        </li>
      ))}
    </ul>
    <p class="meta"><a href={url('')}>Inicio</a></p>
  </main>
</Base>
