---
// Marco común de los 12 simuladores: figura con título y consigna en HTML estático (lo indexa Pagefind); la isla va en el slot.
interface Props {
  nombre: string;
  titulo?: string;
  consigna: string;
}
const { nombre, titulo, consigna } = Astro.props;
const kebab = nombre.replace(/^Sim/, '').replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase();
---
<figure class="sim" data-testid={`sim-${kebab}`} data-simulador={nombre}>
  <figcaption class="sim-cab">
    {titulo && <p class="sim-titulo">{titulo}</p>}
    <p class="sim-consigna">{consigna}</p>
  </figcaption>
  <slot />
  <noscript><p class="sim-nota" style="padding:0 1.1rem 1rem">Este simulador necesita JavaScript.</p></noscript>
</figure>
