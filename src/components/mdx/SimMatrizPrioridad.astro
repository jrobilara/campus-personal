---
import SimMarco from './SimMarco.astro';
import Isla from '../../simuladores/SimMatrizPrioridad';
import { validarPropsSimulador } from '../../simuladores/props';
import { archivoDeTemaDesdeRuta } from '../../lib/errores';
const props = validarPropsSimulador('SimMatrizPrioridad', Astro.props, archivoDeTemaDesdeRuta(Astro.url.pathname));
---
<SimMarco nombre="SimMatrizPrioridad" titulo={props.titulo as string | undefined} consigna={props.consigna as string}>
  <Isla client:visible {...(props as any)} />
</SimMarco>
