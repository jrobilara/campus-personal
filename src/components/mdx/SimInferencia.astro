---
import SimMarco from './SimMarco.astro';
import Isla from '../../simuladores/SimInferencia';
import { validarPropsSimulador } from '../../simuladores/props';
import { archivoDeTemaDesdeRuta } from '../../lib/errores';
const props = validarPropsSimulador('SimInferencia', Astro.props, archivoDeTemaDesdeRuta(Astro.url.pathname));
---
<SimMarco nombre="SimInferencia" titulo={props.titulo as string | undefined} consigna={props.consigna as string}>
  <Isla client:visible {...(props as any)} />
</SimMarco>
