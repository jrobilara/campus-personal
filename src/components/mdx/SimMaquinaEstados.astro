---
import SimFigura from './SimFigura.astro';
import { validarPropsSimulador } from '../../simuladores/props';
import { archivoDeTemaDesdeRuta } from '../../lib/errores';
const props = validarPropsSimulador('SimMaquinaEstados', Astro.props, archivoDeTemaDesdeRuta(Astro.url.pathname));
---
<SimFigura nombre="SimMaquinaEstados" titulo={props.titulo as string | undefined} consigna={props.consigna as string} props={props} />
