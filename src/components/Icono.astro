---
// Íconos SVG propios: los 6 de las áreas (conjunto cerrado de areas.yaml) y los de la navegación.
interface Props { nombre: string; class?: string }
const { nombre, class: clase } = Astro.props;
const trazos: Record<string, string> = {
  // Áreas
  barras: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2" /><path d="M13 9l3-3 3 3" opacity=".0"/>',
  capas: '<path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="m3 13 9 5 9-5"/><path d="m3 17.5 9 5 9-5" opacity=".55"/>',
  servidor: '<rect x="3" y="3.5" width="18" height="7" rx="2"/><rect x="3" y="13.5" width="18" height="7" rx="2"/><path d="M7 7h.01M7 17h.01M12 7h5M12 17h5"/>',
  funcion: '<path d="M3 20c4 0 5-16 9-16s5 16 9 16" /><path d="M3 12h18" opacity=".45"/>',
  campana: '<path d="M2 20c3 0 4-1.5 5-6s2.2-10 5-10 4 5.5 5 10 2 6 5 6" /><path d="M2 20h20"/>',
  auricular: '<path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="13" width="4" height="7" rx="2"/><rect x="17" y="13" width="4" height="7" rx="2"/><path d="M19 20c0 1.5-2 2-5 2"/>',
  // Navegación
  inicio: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10"/><path d="M10 20v-5h4v5"/>',
  repaso: '<rect x="3" y="6" width="14" height="14" rx="2.5"/><path d="M7 3h12a2 2 0 0 1 2 2v12"/><path d="M7.5 13l2.5 2.5 4-5"/>',
  progreso: '<path d="M3 3v18h18"/><path d="m7 15 4-5 3 3 5-7"/>',
  buscar: '<circle cx="11" cy="11" r="6.5"/><path d="m16 16 5 5"/>',
  ajustes: '<path d="M4 6h10M18 6h2M4 12h2M10 12h10M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="8" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>',
};
const d = trazos[nombre];
if (!d) throw new Error(`[ui] Icono desconocido: "${nombre}"`);
---
<svg class={clase} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={d} />
