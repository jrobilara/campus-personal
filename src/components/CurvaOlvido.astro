---
// La curva del olvido de FSRS dibujada de verdad: R(t) = (1 + t / (9·S))^-1, que vale 0,9 cuando t = S.
// Cada repaso (cuando R baja a 0,9) sube la estabilidad S, así que el próximo llega más tarde.
const ESTABILIDADES = [1, 2.4, 5.5, 12, 27];
const W = 520, H = 270, X0 = 14, X1 = 506, Y0 = 38, Y1 = 212;
const R = (t: number, s: number) => 1 / (1 + t / (9 * s));
const reviews = [0];
ESTABILIDADES.forEach((s) => reviews.push(reviews[reviews.length - 1]! + s));
const tFin = reviews[reviews.length - 1]!;
const sx = (t: number) => X0 + (Math.sqrt(t) / Math.sqrt(tFin)) * (X1 - X0);
const sy = (r: number) => Y1 - (Math.max(r, 0.2) - 0.2) / 0.8 * (Y1 - Y0);
const f = (n: number) => n.toFixed(1);

let d = `M ${f(sx(0))} ${f(sy(1))}`;
ESTABILIDADES.forEach((s, i) => {
  const a = reviews[i]!, b = reviews[i + 1]!;
  const pasos = 24;
  for (let k = 1; k <= pasos; k++) {
    const t = a + ((b - a) * k) / pasos;
    d += ` L ${f(sx(t))} ${f(sy(R(t - a, s)))}`;
  }
  if (i < ESTABILIDADES.length - 1) d += ` L ${f(sx(b))} ${f(sy(1))}`;
});
// Sin repasar: la primera curva sigue cayendo.
let fantasma = `M ${f(sx(0))} ${f(sy(1))}`;
for (let k = 1; k <= 60; k++) {
  const t = (tFin * k) / 60;
  fantasma += ` L ${f(sx(t))} ${f(sy(R(t, ESTABILIDADES[0]!)))}`;
}
const puntos = reviews.slice(0, -1).map((t, i) => ({
  x: sx(t), y: sy(1), etiqueta: i === 0 ? 'hoy' : `${Math.round(t)} d`, retraso: 0.3 + 2.3 * (sx(t) - X0) / (X1 - X0),
}));
---
<figure class="curva">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="curva-t curva-d">
    <title id="curva-t">La curva del olvido con repasos espaciados</title>
    <desc id="curva-d">Sin repasar, lo que recordás cae rápido y sigue cayendo. Con repasos, cada vez que baja a 90 % lo repasás y vuelve a 100 %, y la caída es más lenta cada vez: el repaso llega a los 0, 1, 3, 9 y 21 días.</desc>
    <line x1={X0} x2={X1} y1={f(sy(0.9))} y2={f(sy(0.9))} stroke="currentColor" stroke-opacity=".3" stroke-dasharray="3 5" />
    <text x="150" y={f(sy(0.9) + 18)} font-size="13" fill="currentColor" fill-opacity=".65">a 90 % de memoria repasás</text>
    <path d={fantasma} fill="none" stroke="currentColor" stroke-opacity=".35" stroke-width="2" stroke-dasharray="2 6" stroke-linecap="round" />
    <text x={f(sx(tFin) - 4)} y={f(sy(R(tFin, 1)) - 12)} text-anchor="end" font-size="13" fill="currentColor" fill-opacity=".6">sin repasar</text>
    <path class="trazo" pathLength="1" d={d} fill="none" stroke="currentColor" stroke-width="3.2" stroke-linejoin="round" stroke-linecap="round" />
    {puntos.map((p) => (
      <g class="punto" style={`animation-delay:${p.retraso.toFixed(2)}s`}>
        <circle cx={f(p.x)} cy={f(p.y)} r="9" fill="var(--marca)" stroke="var(--tinta)" stroke-width="2.2" />
        <text x={f(Math.min(Math.max(p.x, 24), W - 24))} y={Y1 + 30} text-anchor="middle" font-size="15" font-weight="700" fill="currentColor">{p.etiqueta}</text>
      </g>
    ))}
    <text x={X0} y={H - 6} font-size="13" fill="currentColor" fill-opacity=".6">tiempo desde que lo aprendiste</text>
    <text x={X0} y="13" font-size="13" fill="currentColor" fill-opacity=".6">lo que recordás</text>
  </svg>
  <figcaption>Cada repaso a tiempo aplana la curva: el siguiente puede esperar más. Eso hace el repaso espaciado de la app.</figcaption>
</figure>
