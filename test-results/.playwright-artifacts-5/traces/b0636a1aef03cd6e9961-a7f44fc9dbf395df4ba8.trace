-opacity: 0;\n  fill: none;\n  transition: stroke-opacity 0.2s ease;\n}\n\n.mafs-movable-point-ring {\n  fill: var(--movable-point-color);\n  fill-opacity: 0.25;\n  stroke: none;\n  transition: r 0.2s ease;\n}\n\n.mafs-movable-point-point {\n  fill: var(--movable-point-color);\n  transition: r 0.2s ease;\n}\n\n/* Hover */\n\n.mafs-movable-point:hover .mafs-movable-point-point,\n.mafs-movable-point:focus-visible .mafs-movable-point-point {\n  r: calc(var(--movable-point-ring-size) - 2px);\n}\n\n.mafs-movable-point:hover .mafs-movable-point-ring,\n.mafs-movable-point:focus-visible .mafs-movable-point-ring {\n  r: calc(var(--movable-point-ring-size) + 3px);\n}\n\n.mafs-movable-point.mafs-movable-point-dragging .mafs-movable-point-ring {\n  r: var(--movable-point-ring-size);\n}\n\n/* Focus */\n\n.mafs-movable-point:focus-visible .mafs-movable-point-focus {\n  stroke-opacity: 1;\n}\n"],["STYLE",{},"@font-face {\n  font-family: \"CMU Serif\";\n  font-style: roman;\n  font-weight: 500;\n  src: url(\"/node_modules/computer-modern/fonts/cmu-serif-500-roman.woff2\") format(\"woff2\"), url(\"/node_modules/computer-modern/fonts/cmu-serif-500-roman.ttf\") format(\"truetype\");\n}\n\n@font-face {\n  font-family: \"CMU Serif\";\n  font-style: italic;\n  font-weight: 500;\n  src: url(\"/node_modules/computer-modern/fonts/cmu-serif-500-italic.woff2\") format(\"woff2\"), url(\"/node_modules/computer-modern/fonts/cmu-serif-500-italic.ttf\") format(\"truetype\");\n}\n\n@font-face {\n  font-family: \"CMU Serif\";\n  font-style: roman;\n  font-weight: 700;\n  src: url(\"/node_modules/computer-modern/fonts/cmu-serif-700-roman.woff2\") format(\"woff2\"), url(\"/node_modules/computer-modern/fonts/cmu-serif-700-roman.ttf\") format(\"truetype\");\n}\n\n@font-face {\n  font-family: \"CMU Serif\";\n  font-style: italic;\n  font-weight: 700;\n  src: url(\"/node_modules/computer-modern/fonts/cmu-serif-700-italic.woff2\") format(\"woff2\"), url(\"/node_modules/computer-modern/fonts/cmu-serif-700-italic.ttf\") format(\"truetype\");\n}\n\n.MafsView {\n  font-family: \"CMU Serif\", serif;\n}\n"],["STYLE",{},"/* bricolage-grotesque-vietnamese-wght-normal */\n@font-face {\n  font-family: 'Bricolage Grotesque Variable';\n  font-style: normal;\n  font-display: swap;\n  font-weight: 200 800;\n  src: url(/node_modules/@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-vietnamese-wght-normal.woff2) format('woff2-variations');\n  unicode-range: U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB;\n}\n\n/* bricolage-grotesque-latin-ext-wght-normal */\n@font-face {\n  font-family: 'Bricolage Grotesque Variable';\n  font-style: normal;\n  font-display: swap;\n  font-weight: 200 800;\n  src: url(/node_modules/@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-ext-wght-normal.woff2) format('woff2-variations');\n  unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;\n}\n\n/* bricolage-grotesque-latin-wght-normal */\n@font-face {\n  font-family: 'Bricolage Grotesque Variable';\n  font-style: normal;\n  font-display: swap;\n  font-weight: 200 800;\n  src: url(/node_modules/@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2) format('woff2-variations');\n  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;\n}"],["STYLE",{},"/* Papel cuadriculado de ingeniería: fondo frío, tinta azul-negra y un solo marcador amarillo. */\n:root {\n  color-scheme: light;\n  --papel: #f2f5f8;\n  --superficie: #ffffff;\n  --superficie-2: #e8edf2;\n  --tinta: #0f1b26;\n  --suave: #485767;\n  --linea: #d3dce5;\n  --linea-fuerte: #9fb0c0;\n  --grilla: rgba(30, 90, 150, 0.075);\n  --marca: #ffe14a;\n  --marca-tinta: #0f1b26;\n  --ok: #0f7a43;\n  --ok-fondo: #e1f4e9;\n  --mal: #b3261e;\n  --mal-fondo: #fdebea;\n  --aviso: #8f5300;\n  --aviso-fondo: #fff1d6;\n  --area-claro: #2563eb;\n  --area-oscuro: #60a5fa;\n  --color-area: var(--area-claro);\n  --sombra: 0 1px 0 rgba(15, 27, 38, 0.06), 0 8px 24px -12px rgba(15, 27, 38, 0.25);\n  --f-titulo: 'Bricolage Grotesque Variable', 'Segoe UI', system-ui, sans-serif;\n  --f-texto: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;\n  --f-mono: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, Consolas, monospace;\n  --medida: 40rem;\n  --alto-barra: 3.6rem;\n}\n:root[data-theme='dark'] {\n  color-scheme: dark;\n  --papel: #0d141b;\n  --superficie: #141d26;\n  --superficie-2: #1c2733;\n  --tinta: #e9eef3;\n  --suave: #9eb0c1;\n  --linea: #263544;\n  --linea-fuerte: #46596b;\n  --grilla: rgba(120, 180, 240, 0.055);\n  --marca: #f5d83a;\n  --marca-tinta: #0d141b;\n  --ok: #4fd88b;\n  --ok-fondo: #11301f;\n  --mal: #ff8a80;\n  --mal-fondo: #3a1815;\n  --aviso: #ffc266;\n  --aviso-fondo: #33260b;\n  --color-area: var(--area-oscuro);\n  --sombra: 0 1px 0 rgba(0, 0, 0, 0.4), 0 10px 28px -14px rgba(0, 0, 0, 0.8);\n}\n\n/* El color del área se resuelve en cada elemento que lo declara (var() hereda el valor ya calculado). */\n[style*='--area-claro'] { --color-area: var(--area-claro); }\n:root[data-theme='dark'] [style*='--area-claro'] { --color-area: var(--area-oscuro); }\n*, *::before, *::after { box-sizing: border-box; }\nhtml { -webkit-text-size-adjust: 100%; scroll-padding-top: calc(var(--alto-barra) + 1rem); }\nbody {\n  margin: 0;\n  min-height: 100dvh;\n  background-color: var(--papel);\n  background-image:\n    linear-gradient(var(--grilla) 1px, transparent 1px),\n    linear-gradient(90deg, var(--grilla) 1px, transparent 1px);\n  background-size: 28px 28px;\n  color: var(--tinta);\n  font: 1.0625rem/1.65 var(--f-texto);\n  padding-bottom: calc(4.4rem + env(safe-area-inset-bottom));\n}\n@media (min-width: 52rem) { body { padding-bottom: 0; } }\nh1, h2, h3, h4 { font-family: var(--f-titulo); line-height: 1.15; letter-spacing: -0.01em; text-wrap: balance; margin: 0; }\nh1 { font-size: clamp(2rem, 1.2rem + 3.6vw, 3.4rem); font-weight: 800; letter-spacing: -0.025em; }\nh2 { font-size: clamp(1.45rem, 1.2rem + 1vw, 1.95rem); font-weight: 750; }\nh3 { font-size: 1.25rem; font-weight: 700; }\nh4 { font-size: 1.05rem; font-weight: 700; }\np { margin: 0 0 1em; }\na { color: inherit; text-decoration-color: var(--linea-fuerte); text-underline-offset: 0.2em; }\na:hover { text-decoration-color: var(--color-area); }\n:focus-visible { outline: 3px solid var(--color-area); outline-offset: 2px; border-radius: 4px; }\nimg, svg { max-width: 100%; }\ncode, kbd, samp { font-family: var(--f-mono); font-size: 0.9em; }\n:not(pre) > code { background: var(--superficie-2); padding: 0.1em 0.35em; border-radius: 4px; }\npre { overflow-x: auto; background: var(--superficie); border: 1px solid var(--linea); border-radius: 8px; padding: 0.85rem 1rem; font-size: 0.9rem; line-height: 1.5; }\npre code { background: none; padding: 0; }\ntable { border-collapse: collapse; width: 100%; font-size: 0.95rem; margin-block: 1rem; display: block; overflow-x: auto; }\nth, td { border-bottom: 1px solid var(--linea); padding: 0.45rem 0.75rem; text-align: left; font-variant-numeric: tabular-nums; }\nth { font-family: var(--f-titulo); font-weight: 650; border-bottom: 2px solid var(--tinta); }\n.meta { color: var(--suave); font-size: 0.9rem; }\n.saltar { position: absolute; left: -999px; top: 0; background: var(--marca); color: var(--marca-tinta); padding: 0.5rem 1rem; z-index: 100; }\n.saltar:focus { left: 0.5rem; top: 0.5rem; }\n.solo-lectores { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }\n.marca { background: linear-gradient(transparent 58%, var(--marca) 58%, var(--marca) 92%, transparent 92%); box-decoration-break: clone; -webkit-box-decoration-break: clone; padding-inline: 0.12em; margin-inline: -0.12em; }\n\n/* ---------- Botones ---------- */\n.btn {\n  display: inline-flex; align-items: center; gap: 0.5rem; justify-content: center;\n  font: 650 1rem/1 var(--f-titulo); letter-spacing: 0;\n  min-height: 2.9rem; padding: 0 1.25rem; border-radius: 999px;\n  border: 2px solid var(--tinta); background: var(--superficie); color: var(--tinta);\n  cursor: pointer; text-decoration: none; transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s;\n}\n.btn:hover { transform: translate(-1px, -1px); box-shadow: 3px 3px 0 var(--tinta); }\n.btn:active { transform: none; box-shadow: none; }\n.btn-marca { background: var(--marca); color: var(--marca-tinta); border-color: var(--marca-tinta); }\n:root[data-theme='dark'] .btn { border-color: var(--linea-fuerte); }\n:root[data-theme='dark'] .btn:hover { box-shadow: 3px 3px 0 var(--linea-fuerte); }\n:root[data-theme='dark'] .btn-marca { border-color: var(--marca); color: var(--marca-tinta); }\n.btn-chico { min-height: 2.2rem; padding: 0 0.9rem; font-size: 0.9rem; }\n.btn[disabled], .btn[aria-disabled='true'] { opacity: 0.45; cursor: not-allowed; transform: none; box-shadow: none; }\n.btn-peligro { border-color: var(--mal); color: var(--mal); }\n\n/* ---------- Barra de navegación ---------- */\n.cab { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--papel) 88%, transparent); border-bottom: 1px solid var(--linea); }\n.cab::before { content: ''; position: absolute; inset: 0; z-index: -1; backdrop-filter: blur(10px); }\n.cab-in { max-width: 72rem; margin: 0 auto; padding: 0 1rem; height: var(--alto-barra); display: flex; align-items: center; justify-content: space-between; gap: 1rem; }\n.marca-sitio { display: inline-flex; align-items: center; gap: 0.55rem; font: 800 1.35rem/1 var(--f-titulo); letter-spacing: -0.03em; text-decoration: none; }\n.marca-sitio svg { width: 2rem; height: 1.4rem; color: var(--tinta); }\n.nav { display: flex; gap: 0.15rem; }\n.nav a { position: relative; display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.45rem 0.8rem; border-radius: 999px; text-decoration: none; font: 600 0.95rem/1 var(--f-titulo); color: var(--suave); }\n.nav a:hover { color: var(--tinta); background: var(--superficie-2); }\n.nav a[aria-current='page'] { color: var(--tinta); background: var(--marca); color: var(--marca-tinta); }\n.nav svg { width: 1.3rem; height: 1.3rem; }\n.nav .nav-icono { display: none; }\n.insignia { display: inline-grid; place-items: center; min-width: 1.35rem; height: 1.35rem; padding: 0 0.35rem; border-radius: 999px; background: var(--tinta); color: var(--papel); font: 700 0.75rem/1 var(--f-titulo); font-variant-numeric: tabular-nums; }\n.nav a[aria-current='page'] .insignia { background: var(--marca-tinta); color: var(--marca); }\n.insignia:empty { display: none; }\n@media (max-width: 51.99rem) {\n  .nav { position: fixed; inset: auto 0 0 0; z-index: 60; justify-content: space-around; gap: 0; background: var(--superficie); border-top: 1px solid var(--linea-fuerte); padding: 0.3rem 0.25rem calc(0.3rem + env(safe-area-inset-bottom)); }\n  .nav a { flex: 1; flex-direction: column; gap: 0.2rem; padding: 0.4rem 0.2rem; border-radius: 12px; font-size: 0.72rem; min-width: 0; }\n  .nav .nav-icono { display: block; }\n  .nav a[aria-current='page'] { background: transparent; color: var(--tinta); }\n  .nav a[aria-current='page'] .nav-icono { background: var(--marca); color: var(--marca-tinta); border-radius: 999px; padding: 0.2rem 0.9rem; width: 3.1rem; height: 1.7rem; }\n  .nav .insignia { position: absolute; top: 0.05rem; left: calc(50% + 0.5rem); }\n}\n\n/* ---------- Estructura ---------- */\nmain { max-width: 72rem; margin: 0 auto; padding: 1.5rem 1rem 3rem; }\n.angosto { max-width: 46rem; }\n.pie { max-width: 72rem; margin: 0 auto; padding: 1rem 1rem 3rem; color: var(--suave); font-size: 0.85rem; }\n\n/* ---------- Portada ---------- */\n.hero { display: grid; gap: 2rem; padding-block: 1rem 2.5rem; }\n@media (min-width: 60rem) { .hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: center; gap: 3rem; padding-block: 2rem 3rem; } }\n.hero h1 { max-width: 14ch; }\n.hero .bajada { font-size: 1.15rem; color: var(--suave); max-width: 34rem; margin-top: 1.1rem; }\n.hoy { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 1.75rem; }\n.hoy-n { display: flex; align-items: baseline; gap: 0.6rem; }\n.hoy-n strong { font: 800 3.4rem/1 var(--f-titulo); font-variant-numeric: tabular-nums; letter-spacing: -0.04em; background: var(--marca); color: var(--marca-tinta); padding: 0.05em 0.22em; border-radius: 6px; min-width: 1.6em; text-align: center; }\n.hoy-n span { color: var(--suave); line-height: 1.25; font-size: 0.95rem; }\n.curva { margin: 0; }\n.curva svg { width: 100%; height: auto; display: block; color: var(--tinta); }\n.curva figcaption { font-size: 0.85rem; color: var(--suave); margin-top: 0.4rem; max-width: 30rem; }\n.curva .trazo { stroke-dasharray: 1; stroke-dashoffset: 1; animation: dibujar 2.4s cubic-bezier(0.5, 0, 0.2, 1) 0.2s forwards; }\n.curva .punto { opacity: 0; animation: aparecer 0.35s ease forwards; }\n@keyframes dibujar { to { stroke-dashoffset: 0; } }\n@keyframes aparecer { to { opacity: 1; } }\n@media (prefers-reduced-motion: reduce) {\n  .curva .trazo { animation: none; stroke-dashoffset: 0; }\n  .curva .punto { animation: none; opacity: 1; }\n}\n.titulo-lista { margin-bottom: 1rem; }\n.indice { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; }\n@media (min-width: 52rem) { .indice { grid-template-columns: 1fr 1fr; } }\n.area-fila {\n  display: grid; grid-template-columns: auto 1fr; gap: 0.2rem 1rem; align-items: start;\n  position: relative; overflow: hidden;\n  background: var(--superficie); border: 1px solid var(--linea); border-radius: 4px 14px 14px 4px;\n  padding: 1.1rem 1.1rem 1rem 1.6rem; text-decoration: none; color: inherit; height: 100%;\n  transition: transform 0.15s ease, box-shadow 0.15s ease;\n}\n.area-fila::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 0.6rem; background: var(--color-area); }\n.area-fila:hover { transform: translateY(-2px); box-shadow: var(--sombra); }\n.area-icono { width: 2.8rem; height: 2.8rem; color: var(--color-area); grid-row: span 2; }\n.area-fila h3 { color: var(--tinta); font-size: 1.3rem; }\n.area-fila p { margin: 0; color: var(--suave); font-size: 0.95rem; line-height: 1.5; grid-column: 2; }\n.area-pie { grid-column: 1 / -1; display: flex; align-items: center; gap: 0.9rem; margin-top: 0.7rem; font-size: 0.85rem; color: var(--suave); }\n.medidor { flex: 1; height: 0.5rem; border-radius: 999px; background: var(--superficie-2); overflow: hidden; }\n.medidor > i { display: block; height: 100%; width: var(--valor, 0%); background: var(--color-area); border-radius: 999px; transition: width 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }\n\n/* ---------- Página de área ---------- */\n.area-cab { display: grid; grid-template-columns: auto 1fr; gap: 0.4rem 1.2rem; align-items: center; padding-block: 0.5rem 2rem; border-bottom: 3px solid var(--color-area); margin-bottom: 2rem; }\n.area-cab .area-icono { width: 4.2rem; height: 4.2rem; grid-row: span 2; }\n.area-cab h1 { font-size: clamp(1.8rem, 1.2rem + 2.6vw, 2.8rem); color: var(--tinta); }\n.area-cab p { grid-column: 2; margin: 0; color: var(--suave); max-width: 40rem; }\n.area-cab-acciones { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1rem; }\n.ruta { list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: 1.1rem; }\n.ruta::before { content: ''; position: absolute; left: 0.8rem; top: 0.6rem; bottom: 0.6rem; width: 2px; background: repeating-linear-gradient(var(--color-area) 0 6px, transparent 6px 11px); }\n.paso { position: relative; padding-left: 2.8rem; }\n.paso::before { content: attr(data-n); position: absolute; left: 0; top: 0.15rem; width: 1.65rem; height: 1.65rem; display: grid; place-items: center; border-radius: 50%; background: var(--papel); border: 2px solid var(--color-area); font: 700 0.8rem/1 var(--f-titulo); }\n.paso-cuerpo { background: var(--superficie); border: 1px solid var(--linea); border-radius: 12px; padding: 1rem 1.15rem; }\n.paso-cuerpo h2 { font-size: 1.25rem; }\n.paso-cuerpo h2 a { text-decoration: none; }\n.paso-cuerpo h2 a:hover { text-decoration: underline; text-decoration-color: var(--color-area); text-decoration-thickness: 3px; }\n.paso-cuerpo p { margin: 0.35rem 0 0.7rem; color: var(--suave); font-size: 0.97rem; }\n.chips { display: flex; flex-wrap: wrap; gap: 0.4rem 0.9rem; font-size: 0.85rem; color: var(--suave); align-items: center; }\n.nivel { display: inline-flex; align-items: center; gap: 0.35rem; }\n.nivel i { width: 0.55rem; height: 0.55rem; border-radius: 50%; border: 1.5px solid var(--color-area); }\n.nivel i.on { background: var(--color-area); }\n.paso-progreso { margin-top: 0.7rem; display: flex; align-items: center; gap: 0.7rem; font-size: 0.85rem; color: var(--suave); }\n\n/* ---------- Página de tema ---------- */\n.tema-grid { display: grid; gap: 0; margin-inline: auto; max-width: 46rem; }\n@media (min-width: 70rem) { .tema-grid { grid-template-columns: 11rem minmax(0, 1fr); gap: 2.5rem; max-width: 60rem; } }\n.indice-tema { display: none; }\n@media (min-width: 70rem) {\n  .indice-tema { display: block; position: sticky; top: calc(var(--alto-barra) + 1.5rem); align-self: start; }\n  .indice-tema ol { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--linea); }\n  .indice-tema a { display: block; padding: 0.4rem 0 0.4rem 0.9rem; margin-left: -2px; border-left: 2px solid transparent; text-decoration: none; font: 600 0.92rem/1.2 var(--f-titulo); color: var(--suave); }\n  .indice-tema a:hover { color: var(--tinta); }\n  .indice-tema a.activo { border-left-color: var(--color-area); color: var(--tinta); }\n}\n.tema-cab { max-width: var(--medida); padding-block: 0.5rem 1.5rem; }\n.migas { font: 600 0.9rem/1 var(--f-titulo); margin-bottom: 0.9rem; }\n.migas a { color: var(--color-area); text-decoration: none; }\n.migas a:hover { text-decoration: underline; }\n.tema-cab h1 { font-size: clamp(1.9rem, 1.2rem + 3vw, 3rem); }\n.tema-cab .resumen { font-size: 1.15rem; color: var(--suave); margin-top: 0.9rem; }\n.tema-cab .chips { margin-top: 0.9rem; }\n.cuerpo { counter-reset: seccion; min-width: 0; }\n.cuerpo > section, .cuerpo .seccion { max-width: var(--medida); }\n.seccion { margin-block: 3rem; counter-increment: seccion; }\n.seccion > h2 { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 1rem; }\n.seccion > h2::before { content: counter(seccion); flex: none; width: 2rem; height: 2rem; display: grid; place-items: center; border-radius: 50%; background: var(--color-area); color: var(--papel); font: 700 0.95rem/1 var(--f-titulo); }\n.seccion h3 { margin: 1.8rem 0 0.7rem; }\n.seccion h4 { margin: 1.4rem 0 0.5rem; }\n.seccion ul, .seccion ol { padding-left: 1.3rem; }\n.seccion li { margin-bottom: 0.35rem; }\n.seccion-caso-real .titular { font: 700 clamp(1.3rem, 1.1rem + 1.2vw, 1.75rem)/1.25 var(--f-titulo); letter-spacing: -0.015em; margin-bottom: 1.2rem; }\n.seccion-caso-real .titular span { background: linear-gradient(transparent 55%, var(--marca) 55%, var(--marca) 90%, transparent 90%); box-decoration-break: clone; -webkit-box-decoration-break: clone; padding-inline: 0.1em; margin-inline: -0.1em; color: var(--tinta); }\n.recuadro { border: 1px solid var(--linea); border-left: 5px solid var(--color-area); border-radius: 4px 12px 12px 4px; background: var(--superficie); padding: 0.9rem 1.1rem 0.4rem; margin-block: 1.4rem; }\n.recuadro-titulo { font: 700 1rem/1.2 var(--f-titulo); margin: 0 0 0.45rem; display: flex; align-items: center; gap: 0.5rem; }\n.recuadro.analogia { border-style: dashed; border-left-style: solid; background: color-mix(in srgb, var(--color-area) 7%, var(--superficie)); }\n.recuadro.ojo { border-left-color: var(--aviso); background: var(--aviso-fondo); }\n.recuadro.ojo .recuadro-titulo { color: var(--aviso); }\n.recuadro.nota { border-left-color: var(--linea-fuerte); }\n.formula { margin: 1.5rem 0; background: var(--superficie); border: 1px solid var(--linea); border-radius: 12px; padding: 0.8rem 1.1rem; }\n.formula-nombre { font: 700 0.95rem/1 var(--f-titulo); color: var(--color-area); }\n.formula-tex { overflow-x: auto; padding-block: 0.3rem; }\n.formula-donde { color: var(--suave); font-size: 0.95rem; }\n.formula-donde p:last-child { margin-bottom: 0.3rem; }\n.cita { font-size: 0.72em; }\n.cita a { color: var(--color-area); text-decoration: none; font-weight: 600; white-space: nowrap; }\n.cita a:hover { text-decoration: underline; }\n:target { scroll-margin-top: calc(var(--alto-barra) + 1rem); }\nli:target, .fuente:target { background: var(--marca); color: var(--marca-tinta); }\n.profundizar { border: 1px solid var(--linea); border-radius: 10px; background: var(--superficie); padding: 0.2rem 1rem; margin-block: 1.2rem; }\n.profundizar summary { cursor: pointer; font: 650 1rem/1.4 var(--f-titulo); padding: 0.6rem 0; }\n.katex-display { overflow-x: auto; overflow-y: hidden; padding-block: 0.2rem; }\n\n/* ---------- Páginas simples ---------- */\n.pagina-cab { padding-block: 0.5rem 1.5rem; }\n.pagina-cab p { color: var(--suave); max-width: 38rem; margin-top: 0.7rem; }\n.vacio { background: var(--superficie); border: 2px dashed var(--linea-fuerte); border-radius: 14px; padding: 2rem 1.5rem; text-align: center; }\n.vacio h2 { font-size: 1.4rem; margin-bottom: 0.5rem; }\n.vacio p { color: var(--suave); margin-inline: auto; max-width: 30rem; }\n.aviso { border-radius: 10px; padding: 0.8rem 1rem; margin-block: 1rem; border: 1px solid; }\n.aviso.ok { background: var(--ok-fondo); border-color: var(--ok); color: var(--tinta); }\n.aviso.mal { background: var(--mal-fondo); border-color: var(--mal); color: var(--tinta); }\n.aviso.info { background: var(--superficie-2); border-color: var(--linea-fuerte); }\n.aviso p:last-child { margin-bottom: 0; }\n.aviso ul { margin: 0.4rem 0 0; padding-left: 1.2rem; }\n"],["STYLE",{},"/* Práctica y fuentes de la página de tema, y las islas de ejercicios y casos. */\n.practica-bloque { margin-top: 2.2rem; }\n.practica-bloque > h3 { display: flex; align-items: baseline; gap: 0.6rem; margin-top: 0; }\n.practica-bloque > h3 small { font: 500 0.9rem var(--f-texto); color: var(--suave); }\n\n.fichas { list-style: none; padding: 0 !important; margin: 0 0 1rem; display: grid; gap: 0.6rem; }\n.ficha { background: var(--superficie); border: 1px solid var(--linea); border-radius: 10px; padding: 0.7rem 1rem; }\n.ficha-frente > :last-child { margin-bottom: 0; }\n.ficha p { margin: 0; }\n.ficha details { margin-top: 0.4rem; }\n.ficha summary { cursor: pointer; font: 600 0.9rem var(--f-titulo); color: var(--color-area); padding: 0.2rem 0; }\n.ficha details > div { border-top: 1px dashed var(--linea-fuerte); margin-top: 0.4rem; padding-top: 0.5rem; }\n\n/* Ejercicios */\n.ejercicio { background: var(--superficie); border: 1px solid var(--linea); border-radius: 14px; padding: 1.1rem 1.2rem; margin-bottom: 1rem; }\n.ejercicio-tipo { font: 650 0.8rem var(--f-titulo); color: var(--suave); display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 0.5rem; }\n.enunciado > :last-child { margin-bottom: 0.8rem; }\n.entrada-num { display: flex; align-items: stretch; gap: 0.5rem; flex-wrap: wrap; }\n.entrada-num label { flex: 1 1 100%; font-weight: 600; font-size: 0.92rem; }\n.campo { display: inline-flex; align-items: center; border: 2px solid var(--tinta); border-radius: 10px; background: var(--papel); overflow: hidden; }\n:root[data-theme='dark'] .campo { border-color: var(--linea-fuerte); }\n.campo input { font: 600 1.15rem var(--f-mono); width: 9rem; max-width: 45vw; border: 0; background: transparent; color: inherit; padding: 0.55rem 0.7rem; outline: none; min-width: 0; }\n.campo:focus-within { outline: 3px solid var(--color-area); outline-offset: 2px; }\n.campo .unidad { padding: 0 0.8rem; color: var(--suave); background: var(--superficie-2); align-self: stretch; display: grid; place-items: center; font-weight: 600; }\n.opciones { display: grid; gap: 0.5rem; margin-bottom: 0.9rem; }\n.opcion { display: flex; gap: 0.7rem; align-items: flex-start; padding: 0.65rem 0.85rem; border: 2px solid var(--linea); border-radius: 10px; cursor: pointer; background: var(--papel); }\n.opcion:hover { border-color: var(--linea-fuerte); }\n.opcion:has(input:checked) { border-color: var(--color-area); background: color-mix(in srgb, var(--color-area) 9%, var(--papel)); }\n.opcion input { margin-top: 0.35rem; accent-color: var(--color-area); }\n.opcion p { margin: 0; }\n.opcion.correcta { border-color: var(--ok); background: var(--ok-fondo); }\n.opcion.incorrecta { border-color: var(--mal); background: var(--mal-fondo); }\n.vf { display: flex; gap: 0.6rem; flex-wrap: wrap; }\n.resultado { margin-top: 1rem; border-radius: 10px; padding: 0.8rem 1rem; border-left: 5px solid; }\n.resultado.ok { background: var(--ok-fondo); border-color: var(--ok); }\n.resultado.mal { background: var(--mal-fondo); border-color: var(--mal); }\n.resultado strong.veredicto { font: 750 1.05rem var(--f-titulo); display: block; margin-bottom: 0.3rem; }\n.resultado.ok strong.veredicto { color: var(--ok); }\n.resultado.mal strong.veredicto { color: var(--mal); }\n.resultado > :last-child { margin-bottom: 0; }\n.resultado .por-opcion { margin-top: 0.5rem; }\n.ejercicio-pie { display: flex; gap: 0.8rem; align-items: center; flex-wrap: wrap; margin-top: 0.8rem; font-size: 0.85rem; color: var(--suave); font-variant-numeric: tabular-nums; }\n.error-campo { color: var(--mal); font-size: 0.9rem; margin: 0.4rem 0 0; flex-basis: 100%; }\n\n/* Casos de guardia */\n.caso { background: var(--superficie); border: 1px solid var(--linea); border-radius: 14px; overflow: hidden; margin-bottom: 1.2rem; }\n.caso-cab { padding: 1rem 1.2rem; background: var(--tinta); color: var(--papel); }\n.caso-cab h4 { margin: 0; font-size: 1.15rem; color: var(--papel); }\n.caso-cab .rol { margin: 0.3rem 0 0; font-size: 0.92rem; opacity: 0.85; }\n.caso-cuerpo { padding: 1.1rem 1.2rem 1.3rem; }\n.caso-contexto { color: var(--suave); border-left: 3px solid var(--linea-fuerte); padding-left: 0.9rem; }\n.linea-tiempo { list-style: none; margin: 1rem 0; padding: 0; position: relative; display: grid; gap: 0.7rem; }\n.linea-tiempo li { margin: 0; padding: 0.6rem 0.85rem 0.6rem 2.1rem; position: relative; background: var(--superficie-2); border-radius: 10px; font-size: 0.95rem; }\n.linea-tiempo li::before { content: ''; position: absolute; left: 0.85rem; top: 1rem; width: 0.65rem; height: 0.65rem; border-radius: 50%; background: var(--color-area); }\n.linea-tiempo .eleccion { font-weight: 650; }\n.linea-tiempo .efecto { color: var(--suave); display: block; margin-top: 0.15rem; }\n.decision { margin-top: 1rem; }\n.decision-texto { font-weight: 600; }\n.decision-opciones { display: grid; gap: 0.5rem; margin-top: 0.7rem; }\n.decision-opciones button { text-align: left; font: 500 1rem/1.4 var(--f-texto); padding: 0.75rem 1rem; border: 2px solid var(--linea-fuerte); border-radius: 10px; background: var(--papel); color: inherit; cursor: pointer; transition: border-color 0.12s, background 0.12s; }\n.decision-opciones button:hover { border-color: var(--color-area); background: color-mix(in srgb, var(--color-area) 8%, var(--papel)); }\n.consecuencia { margin: 1rem 0; padding: 0.8rem 1rem; border-radius: 10px; background: var(--aviso-fondo); border-left: 5px solid var(--aviso); }\n.consecuencia p { margin: 0; }\n.desenlace { margin-top: 1rem; padding: 1rem 1.1rem; border-radius: 12px; border: 2px solid; }\n.desenlace.bien { border-color: var(--ok); background: var(--ok-fondo); }\n.desenlace.regular { border-color: var(--aviso); background: var(--aviso-fondo); }\n.desenlace.mal { border-color: var(--mal); background: var(--mal-fondo); }\n.desenlace h5 { margin: 0 0 0.4rem; font: 800 1.15rem var(--f-titulo); }\n.desenlace .leccion { margin-top: 0.8rem; padding-top: 0.7rem; border-top: 1px dashed currentColor; }\n.caso-pie { margin-top: 1rem; display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; font-size: 0.85rem; color: var(--suave); }\n\n/* Problemas */\n.problemas { list-style: none; padding: 0 !important; display: grid; gap: 0.8rem; }\n.problema { border: 1px solid var(--linea); background: var(--superficie); border-radius: 12px; padding: 0.9rem 1.1rem; }\n.problema > :first-child { margin-top: 0; }\n.problema .meta { margin: 0; }\n.dificultad { display: inline-block; font: 650 0.78rem var(--f-titulo); border: 1.5px solid var(--color-area); color: var(--color-area); border-radius: 999px; padding: 0.15rem 0.6rem; margin-bottom: 0.4rem; }\n\n/* Fuentes */\n.lista-fuentes { list-style: none; padding: 0 !important; display: grid; gap: 0.6rem; }\n.fuente { border-left: 4px solid var(--color-area); padding: 0.4rem 0.9rem; background: var(--superficie); border-radius: 0 8px 8px 0; font-size: 0.95rem; }\n.fuente .tipo { display: inline-block; font: 650 0.75rem var(--f-titulo); color: var(--suave); margin-right: 0.4rem; }\n.fuente .clave { font-family: var(--f-mono); font-size: 0.8rem; color: var(--color-area); }\n.fuente a { word-break: break-all; }\n.verificado { margin-top: 1.5rem; }\n\n/* Repaso */\n.repaso { max-width: 40rem; margin-inline: auto; }\n.repaso-avance { display: flex; align-items: center; gap: 0.8rem; margin-bottom: 1rem; font: 600 0.9rem var(--f-titulo); color: var(--suave); font-variant-numeric: tabular-nums; }\n.tarjeta-repaso { background: var(--superficie); border: 2px solid var(--tinta); border-radius: 16px; padding: 1.4rem 1.3rem 1.5rem; box-shadow: 6px 6px 0 var(--color-area); animation: entra-tarjeta 0.28s ease; }\n:root[data-theme='dark'] .tarjeta-repaso { border-color: var(--linea-fuerte); }\n@keyframes entra-tarjeta { from { opacity: 0; transform: translateY(10px); } }\n.tarjeta-origen { font: 650 0.85rem var(--f-titulo); color: var(--color-area); margin: 0 0 0.9rem; }\n.tarjeta-frente { font: 650 clamp(1.25rem, 1.1rem + 1vw, 1.6rem)/1.35 var(--f-titulo); letter-spacing: -0.01em; }\n.tarjeta-frente p { margin: 0; }\n.tarjeta-dorso { margin-top: 1.1rem; padding-top: 1rem; border-top: 2px dashed var(--linea-fuerte); font-size: 1.1rem; animation: aparece-dorso 0.25s ease; }\n@keyframes aparece-dorso { from { opacity: 0; } }\n.tarjeta-dorso p:last-child { margin-bottom: 0; }\n.mostrar { margin-top: 1.5rem; width: 100%; }\nkbd { font: 600 0.75rem var(--f-mono); border: 1px solid currentColor; border-radius: 5px; padding: 0.05rem 0.4rem; opacity: 0.7; }\n.notas { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; }\n@media (min-width: 34rem) { .notas { grid-template-columns: repeat(4, 1fr); } }\n.nota-btn { display: grid; gap: 0.15rem; justify-items: center; padding: 0.7rem 0.4rem; border-radius: 12px; border: 2px solid var(--tinta); background: var(--papel); color: var(--tinta); font: 700 1rem var(--f-titulo); cursor: pointer; transition: transform 0.1s; }\n.nota-btn small { font: 500 0.82rem var(--f-texto); color: var(--suave); }\n.nota-btn:hover:not([disabled]) { transform: translateY(-2px); }\n.nota-btn.n1 { border-color: var(--mal); } .nota-btn.n1:hover { background: var(--mal-fondo); }\n.nota-btn.n2 { border-color: var(--aviso); } .nota-btn.n2:hover { background: var(--aviso-fondo); }\n.nota-btn.n3 { border-color: var(--ok); } .nota-btn.n3:hover { background: var(--ok-fondo); }\n.nota-btn.n4 { border-color: var(--color-area); } .nota-btn.n4:hover { background: color-mix(in srgb, var(--color-area) 12%, var(--papel)); }\n@media (prefers-reduced-motion: reduce) { .tarjeta-repaso, .tarjeta-dorso { animation: none; } }\n\n/* Panel de progreso */\n.panel { display: grid; gap: 2rem; }\n@media (min-width: 62rem) { .panel { grid-template-columns: 1fr 1fr; align-items: start; } .panel .ancho { grid-column: 1 / -1; } }\n.bloque { background: var(--superficie); border: 1px solid var(--linea); border-radius: 14px; padding: 1.1rem 1.2rem 1.3rem; min-width: 0; }\n.bloque > h2 { font-size: 1.25rem; margin-bottom: 0.2rem; }\n.bloque > .meta { margin-top: 0; }\n.cifras { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 0.8rem; }\n.cifra strong { display: block; font: 800 2.4rem/1 var(--f-titulo); font-variant-numeric: tabular-nums; letter-spacing: -0.03em; }\n.cifra span { font-size: 0.85rem; color: var(--suave); }\n.areas-lista { list-style: none; padding: 0; margin: 0.6rem 0 0; display: grid; gap: 0.4rem; }\n.areas-lista button { width: 100%; display: grid; grid-template-columns: 1fr auto; gap: 0.2rem 0.8rem; text-align: left; padding: 0.55rem 0.8rem; border-radius: 10px; border: 2px solid transparent; background: var(--papel); color: inherit; font: 600 0.95rem var(--f-titulo); cursor: pointer; border-left: 6px solid var(--color-area); }\n.areas-lista button[aria-expanded='true'] { border-color: var(--color-area); }\n.areas-lista .medidor { grid-column: 1 / -1; }\n.desglose { margin: 0.3rem 0 0.4rem; padding: 0.6rem 0.9rem; background: var(--papel); border-radius: 10px; font-size: 0.92rem; display: grid; gap: 0.2rem; }\n.desglose dt { display: inline; font-weight: 700; }\n.desglose dd { display: inline; margin: 0; }\n.grafico svg { display: block; max-width: 100%; height: auto; }\n.proximos { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.4rem; margin-top: 0.8rem; text-align: center; }\n.proximos .dia { display: grid; gap: 0.2rem; font-size: 0.78rem; color: var(--suave); }\n.proximos .col { height: 4.2rem; display: flex; align-items: flex-end; }\n.proximos .col i { display: block; width: 100%; min-height: 3px; background: var(--tinta); border-radius: 4px 4px 0 0; height: var(--h); transition: height 0.5s; }\n.proximos b { font: 700 0.95rem var(--f-titulo); color: var(--tinta); font-variant-numeric: tabular-nums; }\n.calendario { overflow-x: auto; padding-bottom: 0.3rem; }\n.leyenda-cal { display: flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; color: var(--suave); margin-top: 0.4rem; }\n.leyenda-cal i { width: 0.9rem; height: 0.9rem; border-radius: 3px; display: inline-block; }\n\n/* Ajustes */\n.ajustes { display: grid; gap: 1.2rem; max-width: 46rem; }\n.ajustes .bloque h2 { margin-bottom: 0.5rem; }\n.segmentos { display: inline-flex; border: 2px solid var(--tinta); border-radius: 999px; overflow: hidden; }\n:root[data-theme='dark'] .segmentos { border-color: var(--linea-fuerte); }\n.segmentos label { cursor: pointer; }\n.segmentos input { position: absolute; opacity: 0; pointer-events: none; }\n.segmentos span { display: block; padding: 0.55rem 1.1rem; font: 650 0.95rem var(--f-titulo); }\n.segmentos input:checked + span { background: var(--marca); color: var(--marca-tinta); }\n.segmentos input:focus-visible + span { outline: 3px solid var(--color-area); outline-offset: -3px; }\n.fila-acciones { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; margin-top: 0.8rem; }\n.campo-simple { font: 600 1.05rem var(--f-mono); width: 6rem; padding: 0.5rem 0.7rem; border: 2px solid var(--tinta); border-radius: 10px; background: var(--papel); color: inherit; }\n:root[data-theme='dark'] .campo-simple { border-color: var(--linea-fuerte); }\n.campo-simple:focus-visible { outline: 3px solid var(--color-area); }\n.archivo-oculto { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; }\n\n/* Buscador */\n.buscador { max-width: 46rem; }\n.buscador-campo { display: flex; gap: 0.6rem; flex-wrap: wrap; }\n.buscador-campo input[type='search'] { flex: 1 1 14rem; font: 500 1.1rem var(--f-texto); padding: 0.75rem 1rem; border: 2px solid var(--tinta); border-radius: 12px; background: var(--superficie); color: inherit; min-width: 0; }\n:root[data-theme='dark'] .buscador-campo input[type='search'] { border-color: var(--linea-fuerte); }\n.buscador-campo input:focus-visible { outline: 3px solid var(--color-area); }\n.buscador select { font: 600 0.95rem var(--f-titulo); padding: 0 0.8rem; border: 2px solid var(--linea-fuerte); border-radius: 12px; background: var(--superficie); color: inherit; min-height: 3rem; }\n.resultados { list-style: none; padding: 0; margin: 1.2rem 0 0; display: grid; gap: 0.8rem; }\n.resultado-busqueda { background: var(--superficie); border: 1px solid var(--linea); border-left: 6px solid var(--color-area); border-radius: 4px 12px 12px 4px; padding: 0.8rem 1rem; }\n.resultado-busqueda h3 { font-size: 1.1rem; margin: 0 0 0.1rem; }\n.resultado-busqueda h3 a { text-decoration: none; }\n.resultado-busqueda h3 a:hover { text-decoration: underline; }\n.resultado-busqueda p { margin: 0.3rem 0 0; font-size: 0.95rem; color: var(--suave); }\n.resultado-busqueda mark { background: var(--marca); color: var(--marca-tinta); padding: 0 0.1em; border-radius: 3px; }\n.area-etiqueta { font: 650 0.8rem var(--f-titulo); color: var(--color-area); }\n"],["STYLE",{},"/* Kit visual común de los 12 simuladores. Las islas usan estas clases (ver src/simuladores/ui.tsx). */\n.sim { margin: 1.8rem 0; background: var(--superficie); border: 1px solid var(--linea-fuerte); border-radius: 14px; overflow: hidden; box-shadow: var(--sombra); max-width: 100%; }\n.sim-cab { padding: 0.75rem 1.1rem 0.7rem; border-bottom: 1px solid var(--linea); background: color-mix(in srgb, var(--color-area) 8%, var(--superficie)); }\n.sim-titulo { font: 700 1.02rem/1.2 var(--f-titulo); margin: 0 0 0.25rem; }\n.sim-consigna { margin: 0; font-size: 0.95rem; color: var(--suave); }\n.sim-consigna::before { content: 'Probá: '; font-weight: 700; color: var(--tinta); }\n.sim-cuerpo { padding: 0.9rem 1.1rem 1.1rem; display: grid; gap: 1rem; }\n.sim-lienzo { min-width: 0; width: 100%; }\n.sim-lienzo svg, .sim-lienzo canvas { display: block; width: 100%; height: auto; }\n.sim-lienzo figure { margin: 0; }\n.sim-plot { overflow-x: auto; }\n.sim-plot svg { font-family: var(--f-texto); color: var(--tinta); }\n.sim-controles { display: grid; gap: 0.75rem 1.2rem; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); align-items: end; }\n.sim-control { display: grid; gap: 0.2rem; min-width: 0; }\n.sim-control > label, .sim-control > .etiqueta { font: 600 0.85rem/1.2 var(--f-titulo); display: flex; justify-content: space-between; gap: 0.5rem; }\n.sim-control output { font-family: var(--f-mono); font-weight: 600; color: var(--color-area); font-size: 0.85rem; }\n.sim input[type='range'] { width: 100%; accent-color: var(--color-area); height: 1.6rem; margin: 0; cursor: pointer; }\n.sim select { font: 500 0.95rem var(--f-texto); padding: 0.45rem 0.6rem; border-radius: 8px; border: 2px solid var(--linea-fuerte); background: var(--papel); color: inherit; min-height: 2.4rem; }\n.sim-toggle { display: flex; gap: 0.55rem; align-items: center; font: 600 0.9rem var(--f-titulo); cursor: pointer; min-height: 2.4rem; }\n.sim-toggle input { width: 1.2rem; height: 1.2rem; accent-color: var(--color-area); }\n.sim-botones { display: flex; flex-wrap: wrap; gap: 0.5rem; }\n.sim-btn { font: 650 0.9rem var(--f-titulo); min-height: 2.4rem; padding: 0 0.95rem; border-radius: 999px; border: 2px solid var(--tinta); background: var(--papel); color: var(--tinta); cursor: pointer; transition: background 0.12s; }\n:root[data-theme='dark'] .sim-btn { border-color: var(--linea-fuerte); }\n.sim-btn:hover:not([disabled]) { background: var(--marca); color: var(--marca-tinta); border-color: var(--marca-tinta); }\n.sim-btn[aria-pressed='true'], .sim-btn.activo { background: var(--tinta); color: var(--papel); }\n.sim-btn[disabled] { opacity: 0.4; cursor: not-allowed; }\n.sim-lecturas { display: grid; grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr)); gap: 0.5rem; margin: 0; }\n.lectura { background: var(--papel); border: 1px solid var(--linea); border-radius: 10px; padding: 0.45rem 0.7rem; min-width: 0; }\n.lectura dt { font: 600 0.74rem/1.2 var(--f-titulo); color: var(--suave); }\n.lectura dd { margin: 0.1rem 0 0; font: 700 1.2rem/1.2 var(--f-mono); font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }\n.lectura dd .u { font: 500 0.8rem var(--f-texto); color: var(--suave); margin-left: 0.2rem; }\n.lectura.alerta { border-color: var(--mal); background: var(--mal-fondo); }\n.lectura.buena { border-color: var(--ok); background: var(--ok-fondo); }\n.sim-leyenda { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; font-size: 0.82rem; color: var(--suave); }\n.sim-leyenda i { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 3px; margin-right: 0.35rem; vertical-align: -0.1em; }\n.sim-nota { font-size: 0.82rem; color: var(--suave); margin: 0; }\n.sim-log { font: 0.82rem/1.5 var(--f-mono); background: var(--papel); border: 1px solid var(--linea); border-radius: 8px; padding: 0.5rem 0.7rem; max-height: 9.5rem; overflow-y: auto; margin: 0; list-style: none; }\n.sim-estado { display: inline-block; font: 700 0.95rem var(--f-titulo); padding: 0.15rem 0.7rem; border-radius: 999px; background: var(--marca); color: var(--marca-tinta); }\n.sim-tabla { overflow-x: auto; }\n.sim-tabla table { display: table; margin: 0; font-size: 0.85rem; }\n.sim-tabla td, .sim-tabla th { padding: 0.25rem 0.55rem; white-space: nowrap; }\n.sim-pre-carga { color: var(--suave); padding: 1.2rem; text-align: center; font-size: 0.9rem; }\n@media (prefers-reduced-motion: reduce) { .sim * { transition: none !important; animation: none !important; } }\n\n/* ---- SimBayes (prefijo sb-) ---- */\n.sb { --sb-enf: var(--mal); --sb-san: var(--color-area); }\n.sb-cab { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.4rem 0.8rem; margin-bottom: 0.5rem; }\n.sb-cab-t { font: 600 0.85rem var(--f-titulo); color: var(--suave); }\n.sb-grilla { background: var(--papel); border: 1px solid var(--linea); border-radius: 10px; padding: 4px; box-sizing: border-box; }\n.sb-p { transition: transform 0.6s cubic-bezier(0.22, 0.8, 0.25, 1), fill 0.3s, stroke 0.3s; }\n.sb-vp { fill: var(--sb-enf); background: var(--sb-enf); }\n.sb-fn { fill: transparent; stroke: var(--sb-enf); stroke-width: 1.5; }\n.sb-fp { fill: var(--sb-san); background: var(--sb-san); }\n.sb-vn { fill: color-mix(in srgb, var(--sb-san) 30%, transparent); }\n.sb-nota { margin-top: 0.4rem; }\n.sb-leyenda { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 0.25rem 1rem; font-size: 0.85rem; }\n.sb-leyenda li { display: grid; grid-template-columns: auto 1fr auto; gap: 0.45rem; align-items: center; margin: 0; }\n.sb-leyenda strong { font: 700 0.9rem var(--f-mono); font-variant-numeric: tabular-nums; }\n.sb-arbol { max-width: 30rem; margin-inline: auto; }\n.sb-arbol .sb-lineas path { stroke: var(--linea-fuerte); stroke-width: 1.5; }\n.sb-arbol rect { fill: var(--superficie); stroke: var(--linea-fuerte); stroke-width: 1.5; }\n.sb-arbol .sb-raiz rect { fill: var(--papel); }\n.sb-arbol .sb-medio-e rect { stroke: var(--sb-enf); }\n.sb-arbol .sb-medio-s rect { stroke: var(--sb-san); }\n.sb-arbol .sb-hoja-vp rect { fill: color-mix(in srgb, var(--sb-enf) 18%, var(--superficie)); stroke: var(--sb-enf); }\n.sb-arbol .sb-hoja-fn rect { stroke: var(--sb-enf); stroke-dasharray: 4 3; }\n.sb-arbol .sb-hoja-fp rect { fill: color-mix(in srgb, var(--sb-san) 18%, var(--superficie)); stroke: var(--sb-san); }\n.sb-arbol .sb-hoja-vn rect { stroke: var(--sb-san); stroke-dasharray: 4 3; }\n.sb-arbol text { fill: var(--tinta); }\n.sb-arbol .sb-n { font: 700 14px var(--f-mono); }\n.sb-arbol .sb-t { font: 500 9.5px var(--f-texto); fill: var(--suave); }\n.sb-arbol .sb-medio .sb-t { font-size: 10.5px; }\n.sb-positivos { background: var(--papel); border: 1px solid var(--linea); border-radius: 10px; padding: 0.7rem 0.85rem; }\n.sb-positivos-t { margin: 0 0 0.55rem; font-size: 0.95rem; }\n.sb-barra { display: flex; height: 1.1rem; border-radius: 999px; overflow: hidden; background: var(--linea); }\n.sb-barra-vp { background: var(--sb-enf); min-width: 0; }\n.sb-barra-fp { background: var(--sb-san); min-width: 0; }\n.sb-barra-pie { display: flex; justify-content: space-between; gap: 0.5rem; font-size: 0.78rem; color: var(--suave); margin-top: 0.3rem; }\n.sb-barra-pie i { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 50%; margin: 0 0.35rem; vertical-align: -0.05em; }\n.sb .sim-control output { white-space: nowrap; flex: none; }\n\n/* ── SimDistribucion (.sd-) y SimInferencia (.si-) ── */\n.sd-cabecera { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.3rem 1rem; }\n.sd-formula { font: 700 1rem var(--f-mono); color: var(--tinta); overflow-wrap: anywhere; }\n.sd-prob { font: 500 0.95rem var(--f-mono); color: var(--suave); background: color-mix(in srgb, var(--color-area) 12%, var(--papel)); border: 1px solid var(--linea); border-radius: 999px; padding: 0.15rem 0.75rem; transition: background 0.2s; }\n.sd-prob b { color: var(--color-area); font-weight: 800; }\n.si-subtitulo { margin: 0 0 0.25rem; font-size: 0.88rem; color: var(--suave); overflow-wrap: anywhere; }\n.si-subtitulo b { color: var(--tinta); font-family: var(--f-titulo); }\n.sim-plot .grafico { min-width: 0; }\n\n/* ===== SimFuncion y SimTransformacion2D (Mafs): prefijo sf- ===== */\n:root { --sf-naranja: #c2410c; --sf-violeta: #6d3fe0; --sf-cian: #0b7285; }\n:root[data-theme='dark'] { --sf-naranja: #ff9b4a; --sf-violeta: #b8a1ff; --sf-cian: #3bc9db; }\n.sim .MafsView {\n  --mafs-bg: var(--superficie); --mafs-fg: var(--tinta); --mafs-origin-color: var(--linea-fuerte);\n  --mafs-line-color: var(--linea); --grid-line-subdivision-color: var(--linea);\n  touch-action: pan-y; border: 1px solid var(--linea); border-radius: 10px; font-size: 0.78rem;\n}\n.sim .MafsView text { fill: var(--mafs-fg); font-family: var(--f-texto); }\n.sf-lienzo { position: relative; }\n.sf-pila { display: grid; gap: 0.2rem; min-width: 0; }\n.sf-eje-titulo { margin: 0.4rem 0 0.1rem; font: 650 0.82rem/1.2 var(--f-titulo); color: var(--suave); }\n.sf-eje-pie { margin: 0 0 0.3rem; font: 500 0.76rem/1.2 var(--f-texto); color: var(--suave); text-align: right; }\n.sf-par { display: contents; }\n@keyframes sf-aparece { from { opacity: 0; transform: scale(0.2); } to { transform: scale(1); } }\n.sf-pop { transform-box: fill-box; transform-origin: center; animation: sf-aparece 0.32s ease-out backwards; }\n.sf-matriz { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 1rem; padding: 0.55rem 1rem; position: relative; max-width: 26rem; }\n.sf-matriz::before, .sf-matriz::after { content: ''; position: absolute; top: 0; bottom: 0; width: 0.55rem; border: 2px solid var(--tinta); }\n.sf-matriz::before { left: 0; border-right: 0; border-radius: 6px 0 0 6px; }\n.sf-matriz::after { right: 0; border-left: 0; border-radius: 0 6px 6px 0; }\n.sf-matriz-fija { font: 700 1.15rem/1.4 var(--f-mono); text-align: center; font-variant-numeric: tabular-nums; }\n.sf-fila-presets { display: grid; gap: 0.3rem; }\n.sf-fila-presets > .etiqueta { font: 600 0.85rem/1.2 var(--f-titulo); }\n.sf-controles-t { display: grid; gap: 0.9rem 1.5rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); align-items: start; }\n\n/* ---- SimFuncion · barra de estado del descenso ---- */\n.sf-estado-barra { display: flex; gap: 0.6rem; align-items: center; padding: 0.5rem 0.8rem; border-radius: 10px; border: 2px solid var(--ok); background: var(--ok-fondo); color: var(--tinta); font: 500 0.9rem/1.35 var(--f-texto); transition: background 0.25s, border-color 0.25s; }\n.sf-estado-barra b { font: 800 0.95rem var(--f-titulo); }\n.sf-estado-punto { flex: none; width: 0.85rem; height: 0.85rem; border-radius: 50%; background: var(--ok); }\n.sf-estado-barra.oscilando { border-color: var(--aviso); background: var(--aviso-fondo); }\n.sf-estado-barra.oscilando .sf-estado-punto { background: var(--aviso); }\n.sf-estado-barra.divergiendo { border-color: var(--mal); background: var(--mal-fondo); }\n.sf-estado-barra.divergiendo .sf-estado-punto { background: var(--mal); }\n\n/* ===== SimGrafo (prefijo sg-) ===== */\n.sg { container-type: inline-size; }\n.sg-envuelto { display: grid; gap: 0.9rem; align-items: start; }\n.sg-envuelto.una { max-width: 36rem; margin-inline: auto; width: 100%; }\n@container (min-width: 40rem) { .sg-envuelto:not(.una) { grid-template-columns: minmax(0, 1.7fr) minmax(11rem, 1fr); } }\n.sg-lienzo { background: var(--papel); border: 1px solid var(--linea); border-radius: 10px; padding: 0.3rem; }\n.sg-svg { font-family: var(--f-texto); touch-action: manipulation; }\n.sg-arista line { stroke: var(--linea-fuerte); stroke-width: 2.5; stroke-linecap: round; transition: stroke 0.3s; }\n.sg-arista .sg-flecha { fill: var(--linea-fuerte); transition: fill 0.3s; }\n.sg-arista.arbol line { stroke: var(--color-area); stroke-width: 4; }\n.sg-arista.camino line { stroke: var(--color-area); stroke-width: 5.5; }\n.sg-arista.avenida line { stroke: var(--aviso); }\n.sg-arista.avenida.camino line { stroke: var(--color-area); }\n.sg-arista.cumplida line { stroke: var(--ok); }\n.sg-arista.cumplida .sg-flecha { fill: var(--ok); }\n.sg-arista.caida line { stroke: var(--mal); stroke-dasharray: 5 5; }\n.sg-arista.caida .sg-flecha { fill: var(--mal); }\n.sg-arista.deg line { stroke: var(--aviso); stroke-dasharray: 2 5; }\n.sg-arista.deg .sg-flecha { fill: var(--aviso); }\n.sg-arista.sospecha line { stroke: var(--aviso); stroke-width: 5; }\n.sg-arista.descartado line { stroke: var(--linea); stroke-width: 2; stroke-dasharray: 3 6; }\n.sg-arista.falla line { stroke: var(--mal); stroke-width: 6; }\n.sg-rotulo rect { fill: var(--superficie); stroke: var(--linea); stroke-width: 1; }\n.sg-rotulo text { font: 700 12.5px var(--f-mono); fill: var(--tinta); }\n.sg-rotulo.avenida rect { fill: var(--aviso-fondo); stroke: var(--aviso); }\n.sg-rotulo.avenida text { fill: var(--aviso); }\n.sg-nodo { cursor: pointer; outline: none; }\n.sg-forma { fill: var(--superficie); stroke: var(--linea-fuerte); stroke-width: 2.5; transition: fill 0.3s, stroke 0.3s; }\n.sg-texto { font: 700 14px var(--f-titulo); fill: var(--tinta); pointer-events: none; transition: fill 0.3s; }\n.sg-sub { font: 600 11.5px var(--f-texto); fill: var(--suave); pointer-events: none; }\n.sg-sub.bueno { fill: var(--ok); }\n.sg-sub.malo, .sg-sub.caido { fill: var(--mal); }\n.sg-sub.deg { fill: var(--aviso); }\n.sg-sub.ok { fill: var(--ok); }\n.sg-sub.cerrado { font-weight: 800; fill: var(--tinta); }\n.sg-aro { fill: none; stroke: var(--tinta); stroke-width: 2.5; stroke-dasharray: 5 4; opacity: 0; pointer-events: none; }\n.sg-nodo:focus-visible .sg-aro { opacity: 1; }\n.sg-nodo:hover .sg-forma { stroke: var(--tinta); }\n.sg-insignia circle { fill: var(--tinta); }\n.sg-insignia text { font: 800 11px var(--f-mono); fill: var(--papel); pointer-events: none; }\n.sg-nodo.visitado .sg-forma, .sg-nodo.instalado .sg-forma, .sg-nodo.camino .sg-forma { fill: color-mix(in srgb, var(--color-area) 24%, var(--superficie)); stroke: var(--color-area); }\n.sg-nodo.actual .sg-forma { fill: var(--marca); stroke: var(--tinta); }\n.sg-nodo.actual .sg-texto { fill: var(--marca-tinta); }\n.sg-nodo.frontera .sg-forma { stroke: var(--aviso); stroke-width: 4; stroke-dasharray: 6 4; fill: var(--aviso-fondo); }\n.sg-nodo.inicio .sg-forma { stroke-width: 4; }\n.sg-nodo.origen .sg-forma, .sg-nodo.destino .sg-forma { stroke: var(--tinta); stroke-width: 4; fill: var(--marca); }\n.sg-nodo.origen .sg-texto, .sg-nodo.destino .sg-texto { fill: var(--marca-tinta); }\n.sg-nodo.disponible .sg-forma { stroke: var(--ok); stroke-width: 4; fill: var(--ok-fondo); }\n.sg-nodo.bloqueado .sg-forma { stroke-dasharray: 4 4; }\n.sg-nodo.bloqueado .sg-texto { fill: var(--suave); }\n.sg-nodo.ok .sg-forma { stroke: var(--ok); fill: var(--ok-fondo); }\n.sg-nodo.deg .sg-forma { stroke: var(--aviso); stroke-width: 4; fill: var(--aviso-fondo); }\n.sg-nodo.caido .sg-forma { stroke: var(--mal); stroke-width: 4; fill: var(--mal-fondo); }\n.sg-nodo.caido .sg-texto { text-decoration: line-through; }\n.sg-nodo.llega .sg-forma { stroke: var(--ok); fill: var(--ok-fondo); }\n.sg-nodo.nollega .sg-forma { stroke: var(--mal); fill: var(--mal-fondo); }\n.sg-lado { display: grid; gap: 0.8rem; align-content: start; }\n.sg-frontera { background: var(--papel); border: 1px solid var(--linea); border-radius: 10px; padding: 0.6rem 0.75rem; min-height: 6rem; }\n.sg-frontera-t { margin: 0 0 0.5rem; font: 700 0.85rem/1.2 var(--f-titulo); color: var(--suave); }\n.sg-fichas { list-style: none; margin: 0; padding: 0; display: flex; gap: 0.4rem; }\n.sg-fichas.cola { flex-wrap: wrap; }\n.sg-fichas.pila { flex-direction: column; align-items: flex-start; }\n.sg-ficha { margin: 0; padding: 0.2rem 0.7rem; border-radius: 999px; border: 2px dashed var(--aviso); background: var(--aviso-fondo); font: 700 0.88rem var(--f-titulo); }\n.sg-ficha.proxima { border-style: solid; background: var(--marca); color: var(--marca-tinta); border-color: var(--tinta); }\n.sg-vacia { margin: 0; color: var(--suave); font-size: 0.85rem; }\n.sg-estado { min-height: 2.6em; }\n@media (prefers-reduced-motion: reduce) { .sg-svg *, .sg-fichas * { transition: none !important; animation: none !important; } }\n\n/* ===== SimMatrizPrioridad (prefijo smp-) ===== */\n.smp { --smp-1: var(--mal); --smp-2: var(--aviso); --smp-3: var(--color-area); --smp-4: var(--ok); --smp-5: var(--suave); }\n.smp-cap { caption-side: top; text-align: left; font: 700 0.85rem var(--f-titulo); color: var(--suave); padding-bottom: 0.35rem; }\n.smp-matriz { width: 100%; border-collapse: separate; border-spacing: 4px; table-layout: fixed; margin: 0; display: table; }\n.smp-matriz th { font: 700 0.76rem/1.2 var(--f-titulo); color: var(--suave); padding: 0.2rem; text-align: center; }\n.smp-matriz tbody th { text-align: right; padding-right: 0.4rem; width: 4.6rem; }\n.smp-esquina { width: 4.6rem; }\n.smp-celda { height: 4.4rem; vertical-align: top; padding: 0.3rem; border-radius: 10px; border: 2px solid var(--c); background: color-mix(in srgb, var(--c) 14%, var(--superficie)); text-align: left; }\n.smp-celda-p { display: block; font: 800 1rem var(--f-mono); color: var(--c); }\n.smp-chips { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: 0.2rem; }\n.smp-chip { display: inline-grid; place-items: center; width: 1.65rem; height: 1.65rem; border-radius: 50%; background: var(--tinta); color: var(--papel); font: 800 0.8rem var(--f-mono); }\n.smp-chip.hecho { background: transparent; color: var(--suave); border: 2px solid var(--suave); }\n.smp-p1 { --c: var(--smp-1); } .smp-p2 { --c: var(--smp-2); } .smp-p3 { --c: var(--smp-3); } .smp-p4 { --c: var(--smp-4); } .smp-p5 { --c: var(--smp-5); }\n.smp-nota { margin-top: 0.4rem; }\n.smp-aviso { min-height: 2.6em; }\n.smp-cola { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }\n.smp-fila { margin: 0; display: grid; gap: 0.5rem; padding: 0.65rem 0.8rem; background: var(--papel); border: 1px solid var(--linea); border-left: 5px solid var(--linea-fuerte); border-radius: 10px; }\n.smp-fila.mal { border-left-color: var(--mal); background: var(--mal-fondo); }\n.smp-fila.hecho:not(.mal) { border-left-color: var(--ok); }\n.smp-titulo { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: 0.6rem; align-items: start; }\n.smp-lugar { display: inline-grid; place-items: center; min-width: 1.6rem; height: 1.6rem; border-radius: 6px; background: var(--linea); font: 800 0.85rem var(--f-mono); }\n.smp-texto { display: grid; gap: 0.1rem; min-width: 0; }\n.smp-texto strong { font: 700 0.95rem/1.25 var(--f-titulo); }\n.smp-texto small { color: var(--suave); font-size: 0.8rem; line-height: 1.3; }\n.smp-prio { display: inline-block; font: 800 0.9rem var(--f-mono); padding: 0.1rem 0.55rem; border-radius: 999px; border: 2px solid var(--c); color: var(--c); background: color-mix(in srgb, var(--c) 12%, var(--superficie)); }\n.smp-selects { display: flex; flex-wrap: wrap; gap: 0.5rem 0.9rem; align-items: end; }\n.smp-selects .sim-control { flex: 1 1 8rem; }\n.smp-mover { display: flex; gap: 0.35rem; }\n.smp-flecha { min-width: 2.4rem; padding: 0; font-size: 1.05rem; }\n.smp-estado { margin: 0; font-size: 0.85rem; color: var(--suave); }\n.smp-sello { display: inline-block; font: 700 0.76rem var(--f-titulo); padding: 0.05rem 0.5rem; border-radius: 999px; border: 1px solid var(--linea-fuerte); color: var(--tinta); margin-right: 0.3rem; }\n.smp-sello.ok { border-color: var(--ok); color: var(--ok); background: var(--ok-fondo); }\n.smp-sello.mal { border-color: var(--mal); color: var(--mal); background: var(--mal-fondo); }\n.smp-slas { display: grid; gap: 0.2rem; }\n.smp-slas table { width: 100%; }\n[data-modo='descenso'] .sim-lecturas .lectura:has([data-lectura='estado']) { grid-column: 1 / -1; }\n\n/* ---- SimDatos (prefijo sd-) ---- */\n:root { --sd-c1: #2563eb; --sd-c2: #c2410c; --sd-c3: #0b7285; --sd-c4: #6d3fe0; --sd-c5: #a61e6b; }\n:root[data-theme='dark'] { --sd-c1: #60a5fa; --sd-c2: #ff9b4a; --sd-c3: #3bc9db; --sd-c4: #b8a1ff; --sd-c5: #f783ac; }\n.sd-vistas .sim-botones { gap: 0.4rem; }\n.sd-vista { display: grid; gap: 0.5rem; }\n.sd-subtitulo { margin: 0 0 0.25rem; font: 650 0.9rem var(--f-titulo); color: var(--suave); }\n.sd-solo-lector { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }\n.sd-fuera { background: var(--aviso-fondo); color: var(--tinta); border-left: 4px solid var(--aviso); border-radius: 6px; padding: 0.4rem 0.7rem; }\n.sd-tabla { max-height: 17rem; overflow: auto; border: 1px solid var(--linea); border-radius: 10px; background: var(--papel); }\n.sd-tabla table { width: 100%; border-collapse: collapse; }\n.sd-tabla thead th { position: sticky; top: 0; background: var(--superficie); border-bottom: 2px solid var(--linea-fuerte); text-align: left; font: 650 0.78rem var(--f-titulo); z-index: 1; }\n.sd-tabla td { border-bottom: 1px solid var(--linea); }\n.sd-tabla .sd-n { color: var(--suave); text-align: right; font-variant-numeric: tabular-nums; width: 2.4rem; }\n.sd-tabla .sd-num { text-align: right; font-variant-numeric: tabular-nums; font-family: var(--f-mono); }\n.sd-tabla tr.sd-dup td { background: var(--aviso-fondo); }\n.sd-tabla tr.sd-atip td { background: var(--mal-fondo); }\n.sd-tabla td.sd-raro { font-weight: 700; color: var(--mal); }\n.sd-tabla td em { color: var(--mal); font-style: normal; font-weight: 700; }\n.sd-tabla .sd-aviso { color: var(--suave); font-size: 0.78rem; }\n.sd-claves { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; margin-top: 0.4rem; }\n.sd-marca { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 3px; margin-right: 0.35rem; vertical-align: -0.1em; border: 1px solid var(--linea-fuerte); }\n.sd-m-dup { background: var(--aviso-fondo); }\n.sd-m-vacio { background: var(--mal-fondo); border-color: var(--mal); }\n.sd-m-atip { background: var(--mal-fondo); }\n.sd-torta { display: grid; gap: 1rem; align-items: center; justify-items: center; }\n.sd-torta-svg { width: min(15rem, 70%); height: auto; overflow: visible; }\n.sd-trozo { transition: stroke-dasharray 0.5s ease, stroke-dashoffset 0.5s ease; }\n.sd-torta-ref { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; width: 100%; max-width: 26rem; }\n.sd-torta-ref li { display: grid; grid-template-columns: 0.9rem 1fr auto auto; gap: 0.5rem; align-items: center; margin: 0; font-size: 0.9rem; }\n.sd-torta-ref i { width: 0.9rem; height: 0.9rem; border-radius: 3px; }\n.sd-torta-ref strong { font: 700 0.9rem var(--f-mono); font-variant-numeric: tabular-nums; }\n.sd-torta-ref small { color: var(--suave); font-size: 0.78rem; min-width: 5.5rem; text-align: right; }\n@media (min-width: 600px) { .sd-torta { grid-template-columns: auto 1fr; justify-items: start; } .sd-torta-svg { width: 13rem; } }\n.sd-veredicto { display: grid; grid-template-columns: auto 1fr; gap: 0.2rem 0.7rem; align-items: center; border: 1px solid var(--linea-fuerte); border-left-width: 5px; border-radius: 8px; padding: 0.5rem 0.8rem; background: var(--papel); }\n.sd-veredicto p { grid-column: 1 / -1; margin: 0; font-size: 0.92rem; }\n.sd-veredicto strong { font: 700 0.92rem var(--f-titulo); }\n.sd-v-etq { justify-self: start; font: 800 0.78rem var(--f-titulo); text-transform: uppercase; letter-spacing: 0.04em; padding: 0.1rem 0.6rem; border-radius: 999px; }\n.sd-v-bien { border-color: var(--ok); background: var(--ok-fondo); }\n.sd-v-bien .sd-v-etq { background: var(--ok); color: var(--superficie); }\n.sd-v-regular { border-color: var(--aviso); background: var(--aviso-fondo); }\n.sd-v-regular .sd-v-etq { background: var(--aviso); color: var(--superficie); }\n.sd-v-mal { border-color: var(--mal); background: var(--mal-fondo); }\n.sd-v-mal .sd-v-etq { background: var(--mal); color: var(--superficie); }\n.sd-grupo { border: 1px solid var(--linea); border-radius: 10px; padding: 0.4rem 0.8rem 0.5rem; margin: 0; display: grid; gap: 0.1rem 1.2rem; grid-column: 1 / -1; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); min-width: 0; }\n.sd-grupo legend { font: 650 0.8rem var(--f-titulo); color: var(--suave); padding: 0 0.3rem; }\n.sd-controles .sim-toggle { align-self: center; }\n\n/* ===== SimMaquinaEstados: prefijo sm- ===== */\n.sm-grilla { display: grid; gap: 1rem; }\n.sm-izq, .sm-der { display: grid; gap: 0.8rem; min-width: 0; align-content: start; }\n@media (min-width: 880px) { .sm-grilla { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); align-items: start; } }\n.sm-lienzo { background: var(--papel); border: 1px solid var(--linea); border-radius: 10px; padding: 0.4rem; }\n.sm-svg { max-width: 46rem; margin-inline: auto; overflow: visible; }\n.sm-sub { margin: 0 0 0.35rem; font: 650 0.8rem/1.3 var(--f-titulo); color: var(--suave); }\n.sm-nota { font-style: italic; }\n.sm-flecha path { stroke: var(--linea-fuerte); stroke-width: 1.6; }\n.sm-flecha polygon { fill: var(--linea-fuerte); }\n.sm-flecha.viva path, .sm-flecha.viva polygon { stroke: var(--color-area); fill: var(--color-area); }\n.sm-flecha.viva path { stroke-width: 2.6; fill: none; stroke-dasharray: 400; animation: sm-trazo 0.8s ease-out; }\n.sm-flecha.viva polygon { stroke: none; }\n@keyframes sm-trazo { from { stroke-dashoffset: 400; } to { stroke-dashoffset: 0; } }\n.sm-etiqueta { font: 500 10.5px var(--f-texto); fill: var(--suave); paint-order: stroke; stroke: var(--papel); stroke-width: 3.5px; stroke-linejoin: round; }\n.sm-nodo rect { fill: var(--superficie); stroke: var(--linea-fuerte); stroke-width: 1.6; transition: fill 0.25s, stroke 0.25s; }\n.sm-nodo.fantasma rect { stroke-dasharray: 5 4; fill: transparent; }\n.sm-nodo .sm-texto { font: 650 13.5px var(--f-titulo); fill: var(--tinta); transition: fill 0.25s; }\n.sm-nodo .sm-letra { font: 800 20px var(--f-mono); fill: var(--tinta); transition: fill 0.25s; }\n.sm-nodo .sm-sub-nodo { font: 500 10.5px var(--f-texto); fill: var(--suave); transition: fill 0.25s; }\n.sm-nodo.activo rect { fill: var(--marca); stroke: var(--tinta); }\n.sm-nodo.activo .sm-texto, .sm-nodo.activo .sm-letra, .sm-nodo.activo .sm-sub-nodo { fill: var(--marca-tinta); }\n.sm-nodo.activo.alerta rect { fill: var(--mal-fondo); stroke: var(--mal); }\n.sm-nodo.activo.alerta .sm-texto, .sm-nodo.activo.alerta .sm-letra, .sm-nodo.activo.alerta .sm-sub-nodo { fill: var(--tinta); }\n.sm-nota-nodo { font: 600 10.5px var(--f-mono); fill: var(--suave); }\n.sm-anillo { fill: none; stroke: var(--color-area); stroke-width: 2.5; pointer-events: none; }\n.sm-pulso { fill: var(--color-area); stroke: var(--papel); stroke-width: 2; pointer-events: none; }\n.sm-ventana { display: grid; gap: 0.3rem; }\n.sm-pedidos { display: grid; grid-template-columns: repeat(20, 1fr); gap: 3px; }\n.sm-pedido { display: block; aspect-ratio: 1 / 1.6; border-radius: 3px; border: 1px solid var(--linea); transition: background 0.15s; }\n.sm-pedido.ok { background: var(--ok); border-color: var(--ok); }\n.sm-pedido.falla { background: var(--mal); border-color: var(--mal); }\n.sm-medidor { display: grid; gap: 0.3rem; }\n.sm-medidor .sim-nota { margin: 0; }\n.sm-barra { height: 0.8rem; border-radius: 999px; background: var(--linea); overflow: hidden; }\n.sm-barra i { display: block; height: 100%; background: var(--suave); border-radius: 999px; transition: width 0.1s linear, background 0.3s; }\n.sm-barra.lista i { background: var(--ok); }\n.sm-pips { display: flex; gap: 0.4rem; }\n.sm-pip { width: 1.1rem; height: 1.1rem; border-radius: 50%; border: 2px solid var(--linea-fuerte); background: var(--papel); transition: background 0.2s, border-color 0.2s; }\n.sm-pip.llena { background: var(--mal); border-color: var(--mal); }\n.sm-pip.sin-limite { border-style: dashed; }\n.sm-term { margin: 0; background: var(--papel); border: 1px solid var(--linea); border-radius: 8px; overflow: hidden; }\n.sm-term figcaption { font: 600 0.78rem var(--f-mono); padding: 0.3rem 0.7rem; background: var(--superficie-2); color: var(--suave); border-bottom: 1px solid var(--linea); overflow-wrap: anywhere; }\n.sm-term pre { margin: 0; padding: 0.5rem 0.7rem; font: 0.78rem/1.5 var(--f-mono); overflow-x: auto; white-space: pre; background: none; border: 0; }\n.sm-registro .sim-log { max-height: 11rem; }\n.sm-registro li { margin: 0; overflow-wrap: anywhere; }\n.sm-hora { color: var(--color-area); font-weight: 700; margin-right: 0.4rem; }\n.sm .sim-log { padding-left: 0.7rem; }\n.sm-eventos .sim-btn { font-size: 0.82rem; padding: 0.3rem 0.8rem; min-height: 2.4rem; line-height: 1.2; text-align: left; border-radius: 12px; }\n.sm :focus-visible { outline: 3px solid var(--color-area); outline-offset: 2px; }\n\n/* ---- SimFlujo (prefijo sfl-) ---- */\n.sim-lienzo svg text { font-family: var(--f-texto); }\n.sfl-cable { fill: none; stroke: var(--linea-fuerte); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: stroke 0.2s; }\n.sfl-cable.caido { stroke-dasharray: 3 5; opacity: 0.55; }\n.sfl-nodo { fill: var(--papel); stroke: var(--tinta); stroke-width: 2; }\n.sfl-nodo.marca { fill: color-mix(in srgb, var(--color-area) 18%, var(--papel)); stroke: var(--color-area); }\n.sfl-nodo.marca.activo { fill: color-mix(in srgb, var(--color-area) 45%, var(--papel)); }\n.sfl-nodo.cache { fill: color-mix(in srgb, var(--ok) 16%, var(--papel)); stroke: var(--ok); }\n.sfl-nodo.cliente { stroke: var(--suave); }\n.sfl-nodo.cliente.esperando { stroke: var(--marca-tinta, var(--tinta)); fill: color-mix(in srgb, var(--marca) 55%, var(--papel)); }\n.sfl-cliente { fill: var(--papel); stroke: var(--suave); stroke-width: 2; }\n.sfl-nodo-t { font: 700 13px var(--f-titulo); fill: var(--tinta); }\n.sfl-nodo-t.chico { font-size: 11px; }\n.sfl-etq { font: 500 11.5px var(--f-texto); fill: var(--suave); }\n.sfl-etq.fuerte { font: 650 12px var(--f-titulo); fill: var(--tinta); }\n.sfl-srv { fill: var(--papel); stroke: var(--linea-fuerte); stroke-width: 2; transition: fill 0.15s, stroke 0.15s; }\n.sfl-srv.ocupado { fill: color-mix(in srgb, var(--color-area) 30%, var(--papel)); stroke: var(--color-area); }\n.sfl-srv.caido { stroke: var(--mal); stroke-dasharray: 4 3; fill: var(--mal-fondo); }\n.sfl-cruz { stroke: var(--mal); stroke-width: 2.5; stroke-linecap: round; opacity: 0.85; }\n.sfl-carril { fill: color-mix(in srgb, var(--color-area) 5%, var(--papel)); stroke: var(--linea); stroke-width: 1; }\n.sfl-marco { fill: var(--papel); stroke: var(--linea-fuerte); stroke-width: 1.5; }\n.sfl-ranura { fill: none; stroke: var(--linea); stroke-width: 1; }\n.sfl-bloque { fill: var(--color-area); stroke: color-mix(in srgb, var(--color-area) 70%, var(--tinta)); stroke-width: 1; transition: fill 0.2s; }\n.sfl-bloque.kb { fill: var(--ok); stroke: var(--ok); }\n.sfl-bloque.fuera { fill: var(--mal); stroke: var(--mal); }\n.sfl-progreso { fill: var(--color-area); }\n.sfl-barra-fondo { fill: var(--linea); }\n.sfl-barra { fill: var(--color-area); transition: fill 0.2s; }\n.sfl-barra.alerta { fill: var(--mal); }\n.sfl-seg { fill: var(--color-area); }\n.sfl-seg.par { fill: color-mix(in srgb, var(--color-area) 60%, var(--papel)); }\n.sfl-punto { fill: var(--color-area); stroke: var(--papel); stroke-width: 1.2; }\n.sfl-punto.acierto { fill: var(--ok); }\n.sfl-punto.rechazo { fill: var(--mal); }\n.sfl-punto.espera { fill: var(--marca); stroke: var(--tinta); }\n.sfl-capacidad.alerta { color: var(--mal); font-weight: 600; }\n.sfl-insignia { fill: var(--marca); stroke: var(--tinta); stroke-width: 1; }\n.sfl-etq.insignia { font: 700 10px var(--f-titulo); fill: var(--marca-tinta, var(--tinta)); }\n"]],["BODY",{"__playwright_custom_elements__":"astro-island","data-astro-source-file":"/home/juan/Escritorio/Proyectos/campus-personal/src/layouts/Base.astro","data-astro-source-loc":"65:28"},["A",{"class":"saltar","href":"#contenido","data-astro-source-file":"/home/juan/Escritorio/Proyectos/campus-personal/src/layouts/Base.astro","data-astro-source-loc":"66:41"},"Saltar al contenido"],["HEADER",{"class":"cab","data-astro-source-file":"/home/juan/Escritorio/Proyectos/campus-personal/src/layouts/Base.astro","data-astro-source-loc":"67:25"},["DIV",{"class":"cab-in","data-astro-source-file":"/home/juan/Escritorio/Proyectos/campus-personal/src/layouts/Base.astro","data-astro-source-loc":"68:27"},["A",{"class":"marca-sitio","href":"/campus-personal/","aria-label":"Campus personal, ir al inicio","data-astro-source-file":"/home/juan/Escritorio/Proyectos/campus-personal/src/layouts/Base.astro","data-astro-source-loc":"69:90"},["svg",{"viewBox":"0 0 32 22","fill":"none","stroke":"currentColor","stroke-width":"2.4","stroke-linecap":"round","stroke-linejoin":"round","aria-hidden":"true","data-astro-source-file":"/home/juan/Escritorio/Proyectos/campus-personal/src/layouts/Base.astro","data-astro-source-loc":"70:155"},["path",{"d":"M2 3C6 3 8 9 11 15","data-astro-source-file":"/home/juan/Escritorio/Proyectos/campus-personal/src/layouts/Base.as